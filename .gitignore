projects/*/.state/
projects/*/backups/
projects/*/logs/
projects/*/reports/
projects/*/*.before-rebuild-*.csv
# ...and the same folders when litsuite runs without a project (--folder/--output) in the repo root
/backups/
/reports/
/.state/
*.tmp

# Generated analysis artifacts (project figures are kept)
*.png
!projects/*/figures/*.png

