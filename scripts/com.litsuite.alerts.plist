<?xml version="1.0" encoding="UTF-8"?>
<!-- macOS launchd job: runs scripts/run_alerts.sh every day at 07:40.
     1. Replace /PATH/TO/REPO below with the repository folder.
     2. cp scripts/com.litsuite.alerts.plist ~/Library/LaunchAgents/
     3. launchctl load ~/Library/LaunchAgents/com.litsuite.alerts.plist
     Remove with: launchctl unload ~/Library/LaunchAgents/com.litsuite.alerts.plist -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.litsuite.alerts</string>
  <key>ProgramArguments</key>
  <array><string>/bin/bash</string><string>/PATH/TO/REPO/scripts/run_alerts.sh</string></array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>40</integer></dict>
  <key>StandardErrorPath</key><string>/tmp/litsuite-alerts.err</string>
</dict>
</plist>
